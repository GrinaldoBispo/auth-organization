// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

//////////////////////
// ENUMS
//////////////////////

enum UserRole {
  ADMIN
  STAFF
  SUPERADMIN
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

//////////////////////
// AUTH & CORE
//////////////////////

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(STAFF)
  
  orgId         String?
  organization  Organization? @relation(fields: [orgId], references: [id])

  // Relações NextAuth
  accounts      Account[]

  // Relações de Domínio
  scheduleGroups StaffScheduleGroup[]
  breaks         ScheduleBreak[]
  appointments   Appointment[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@map("password_reset_tokens")
}

//////////////////////
// CORE: ORGANIZATION
//////////////////////

model Organization {
  id        String   @id @default(cuid())
  name      String   
  slug      String   @unique 
  phone     String?
  type      String?  

  users          User[]
  customers      Customer[]
  appointments   Appointment[]
  
  scheduleGroups StaffScheduleGroup[]
  scheduleBreaks ScheduleBreak[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("organizations")
}

//////////////////////
// DOMAIN: CUSTOMER
//////////////////////

model Customer {
  id           String   @id @default(cuid())
  name         String
  phone        String   
  email        String?

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@map("customers")
}

//////////////////////
// DOMAIN: APPOINTMENT
//////////////////////

model Appointment {
  id            String            @id @default(cuid())
  date          DateTime
  status        AppointmentStatus @default(SCHEDULED)
  notes         String?           @db.Text

  customerId    String
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  providerId    String?
  provider      User?             @relation(fields: [providerId], references: [id])

  scheduleGroupId String?
  scheduleGroup   StaffScheduleGroup? @relation(fields: [scheduleGroupId], references: [id])

  orgId         String
  organization  Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, date])
  @@map("appointments")
}

//////////////////////
// DOMAIN: StaffSchedule
//////////////////////

model StaffScheduleGroup {
  id           String   @id @default(cuid())
  name         String   
  
  startDate    DateTime 
  endDate      DateTime? 
  slotDuration Int      @default(30) 

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  intervals    StaffScheduleInterval[]
  appointments Appointment[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("staff_schedule_groups")
}

model StaffScheduleInterval {
  id        String   @id @default(cuid())
  startTime String   
  endTime   String   
  
  monday    Boolean  @default(false)
  tuesday   Boolean  @default(false)
  wednesday Boolean  @default(false)
  thursday  Boolean  @default(false)
  friday    Boolean  @default(false)
  saturday  Boolean  @default(false)
  sunday    Boolean  @default(false)

  groupId   String
  group     StaffScheduleGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("staff_schedule_intervals")
}

//////////////////////
// DOMAIN: ScheduleBreak
//////////////////////

model ScheduleBreak {
  id        String   @id @default(cuid())
  date      DateTime 
  startTime String?  
  endTime   String?
  reason    String?  

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  orgId     String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("schedule_breaks")
}

//////////////////////
// SETTINGS
//////////////////////

model SystemSettings {
  id                String   @id @default("system_config")
  smtpHost          String
  smtpPort          String
  smtpUser          String
  smtpPass          String?
  useSecure         Boolean  @default(false)
  fromName          String   @default("Sistema")
  fromEmail         String
  adminNotifyEmail  String
  emailTemplate     String   @db.Text
  updatedAt         DateTime @updatedAt

  @@map("system_settings")
}