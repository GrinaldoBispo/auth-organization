// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"] 
}

datasource db {
  provider = "postgresql"
  // No Prisma 7, a URL é definida apenas no prisma.config.ts
}

//////////////////////
// ENUMS
//////////////////////

enum UserRole {
  ADMIN      // Dono da Organização
  STAFF      // Funcionário (Médico, Barbeiro, etc)
  SUPERADMIN // Você (Gestor da Plataforma)
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

//////////////////////
// AUTH & CORE
//////////////////////

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String?   @unique
  password      String?
  role          UserRole  @default(STAFF)
  
  // 🔗 Vínculo com a Unidade de Negócio
  orgId         String?
  organization  Organization? @relation(fields: [orgId], references: [id])

  // Agendamentos onde este usuário é o prestador
  appointments  Appointment[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Organization {
  id        String   @id @default(cuid())
  name      String   // Nome da Clínica, Salão ou Barbearia
  slug      String   @unique // para futuras URLs: app.com/salao-do-joao
  phone     String?
  type      String?  // 'CLINIC', 'BARBERSHOP', 'SPA'

  users         User[]
  customers     Customer[]
  appointments  Appointment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("organizations")
}

//////////////////////
// DOMAIN: CUSTOMER (Antigo Patient)
//////////////////////

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   // Essencial para o n8n/WhatsApp
  email     String?

  orgId     String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@map("customers")
}

//////////////////////
// DOMAIN: APPOINTMENT
//////////////////////

model Appointment {
  id        String            @id @default(cuid())
  date      DateTime
  status    AppointmentStatus @default(SCHEDULED)
  notes     String?           @db.Text

  // Quem vai receber o serviço
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Quem vai realizar o serviço (Opcional, pode ser apenas a org)
  providerId String?
  provider   User?    @relation(fields: [providerId], references: [id])

  orgId      String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, date])
  @@map("appointments")
}