generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

//////////////////////
// ENUMS
//////////////////////

enum UserRole {
  ADMIN
  STAFF
  SUPERADMIN
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

//////////////////////
// AUTH & CORE
//////////////////////

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(STAFF)
  
  orgId         String?
  organization  Organization? @relation(fields: [orgId], references: [id])

  // Relações Ajustadas
  scheduleGroups StaffScheduleGroup[]
  breaks         ScheduleBreak[]
  appointments   Appointment[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Organization {
  id        String   @id @default(cuid())
  name      String   
  slug      String   @unique 
  phone     String?
  type      String?  

  users          User[]
  customers      Customer[]
  appointments   Appointment[]
  
  // Relações Ajustadas
  scheduleGroups StaffScheduleGroup[]
  scheduleBreaks ScheduleBreak[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("organizations")
}

//////////////////////
// DOMAIN: CUSTOMER
//////////////////////

model Customer {
  id           String   @id @default(cuid())
  name         String
  phone        String   
  email        String?

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@map("customers")
}

//////////////////////
// DOMAIN: APPOINTMENT
//////////////////////

model Appointment {
  id           String            @id @default(cuid())
  date         DateTime
  status       AppointmentStatus @default(SCHEDULED)
  notes        String?           @db.Text

  customerId   String
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  providerId   String?
  provider     User?             @relation(fields: [providerId], references: [id])

  orgId        String
  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, date])
  @@map("appointments")
}

//////////////////////
// DOMAIN: StaffSchedule (ESTRUTURA DE GRADE)
//////////////////////

model StaffScheduleGroup {
  id           String   @id @default(cuid())
  name         String   // Ex: "Agenda Principal - Manhã"
  
  startDate    DateTime // Data Inicial da vigência
  endDate      DateTime? // Data Final da vigência
  slotDuration Int      @default(30) // Tempo de atendimento em minutos

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  intervals    StaffScheduleInterval[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("staff_schedule_groups")
}

model StaffScheduleInterval {
  id        String   @id @default(cuid())
  startTime String   // Ex: "08:00"
  endTime   String   // Ex: "12:00"
  
  // Dias da semana
  monday    Boolean  @default(false)
  tuesday   Boolean  @default(false)
  wednesday Boolean  @default(false)
  thursday  Boolean  @default(false)
  friday    Boolean  @default(false)
  saturday  Boolean  @default(false)
  sunday    Boolean  @default(false)

  groupId   String
  group     StaffScheduleGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("staff_schedule_intervals")
}

//////////////////////
// DOMAIN: ScheduleBreak
//////////////////////

model ScheduleBreak {
  id        String   @id @default(cuid())
  date      DateTime 
  startTime String?  
  endTime   String?
  reason    String?  

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  orgId     String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("schedule_breaks")
}

model SystemSettings {
  id               String   @id @default("system_config")
  smtpHost         String
  smtpPort         String
  smtpUser         String
  smtpPass         String?
  useSecure        Boolean  @default(false)
  fromName         String   @default("Sistema")
  fromEmail        String
  adminNotifyEmail String
  emailTemplate    String   @db.Text
  updatedAt        DateTime @updatedAt
}